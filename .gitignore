# ==============================================================================
# RetailIQ — .gitignore for GitHub
# Prevents large database files, credentials, and dependency folders from uploading
# ==============================================================================

# --- 1. Large Database Files (GitHub 100MB File Limit) ---
# NOTE: data/retail_iq.db is ~132MB. GitHub rejects files > 100MB.
# Anyone cloning can regenerate it instantly by running: python src/db_loader.py
*.db
*.sqlite
*.sqlite3
data/*.db

# --- 2. Environment Variables & Secrets ---
# Keep .env.example committed; never upload real credentials
.env
.env.local
.env.*.local

# --- 3. Frontend & Node Dependencies ---
frontend/node_modules/
node_modules/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- 4. Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# --- 5. Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- 6. Operating System & IDE Artifacts ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# --- 7. Temporary / Scratch Scripts ---
scratch/
scratch_*.py
test_*.py
frontend/dist/
